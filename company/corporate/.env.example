# OpenAI / ChatGPT (optional alternative)
OPENAI_API_KEY=

# Which model the agent uses. Verified working with this app's agent:
# gpt-5.6-terra (current choice) and gpt-5.1. gpt-5-mini is a cheaper
# option for simple dictated entries.
OPENAI_MODEL=gpt-5.6-terra

# Session-cookie signing secret — auto-generated on first run if missing.
BOOKKEEP_SECRET=auto-generated

# Sign-in email codes. Give ONE of these; with neither, the code step is skipped on the real site.
# Gmail: turn on 2-Step Verification for the Google account, then Google Account → Security →
# App passwords → create one for "hardywu" and paste the 16 letters here.
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Hardy Wu <you@gmail.com>"
# or Resend (resend.com → API keys); sending to anyone needs a verified domain there.
RESEND_API_KEY=
# LOGIN_VERIFY=off turns the code step off entirely (not recommended).
