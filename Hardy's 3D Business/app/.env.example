# Copy to .env.local and fill in as accounts are created.
# The app runs WITHOUT any of these: checkout switches to demo mode (no payment
# taken) and order emails are logged to the console instead of sent.

# Stripe (payments) — from dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
# from Developers → Webhooks → endpoint for /api/webhook
STRIPE_WEBHOOK_SECRET=

# Resend (order emails) — from resend.com → API keys
RESEND_API_KEY=
# Sender; the resend.dev default works without domain setup
EMAIL_FROM="Hardy's 3D <onboarding@resend.dev>"
OWNER_EMAIL=barbaratao@gmail.com

# Vercel Blob (customer image uploads) — auto-set when deployed on Vercel;
# without it, uploads land in public/uploads (fine for local testing)
BLOB_READ_WRITE_TOKEN=
